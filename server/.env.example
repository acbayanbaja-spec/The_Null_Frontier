# Server
PORT=3000
# Comma-separated list of allowed origins, or * to allow any (mobile game clients
# typically send no Origin header; * is safe here since auth uses Bearer tokens).
CORS_ORIGIN=*

# Supabase (Project Settings -> API). The server boots without these, but every
# auth-dependent route returns 503 { "error": "backend_not_configured" }.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. Only used by admin/maintenance scripts. NEVER used on
# user-authenticated routes (anon key + user JWT keeps Row Level Security in force).
SUPABASE_SERVICE_KEY=
